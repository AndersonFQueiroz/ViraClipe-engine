# ViraClipe — env template (tudo free)
# cp .env.example .env

# Telegram (log + /status + /remover, sem aprovação)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Gemini Flash free (AI Studio) — scoring + títulos
GEMINI_API_KEY=
# Pool p/ rodízio em 429 (vírgula, sem espaço): dobra a quota free
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash

# Discovery free
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
# Kick sem chave (via yt-dlp)

# Postagem (Buffer plano grátis)
BUFFER_API_KEY=

# Tuning (público capado — full afina via env)
SCORE_THRESHOLD=75
DAILY_CAP=5
MIN_VIEWERS=200
MAX_VODS_DIA=5
POLL_INTERVAL=3600
SCORE_W_CHAT=0.5
SCORE_W_AUDIO=0.2
SCORE_W_LLM=0.3
SIGNAL_W_CHAT=0.7
SIGNAL_W_AUDIO=0.3
LLM_PACE_SEC=8
SCORE_GEMINI_TOPN=8

# SPLIT privado (NÃO commitar valores — só via env/GH Secrets no modo full)
# VIRACLIP_PROMPT= (ou VIRACLIP_PROMPT_B64=)
# VIRACLIP_BLOCKLIST=termo1,termo2 (ou VIRACLIP_BLOCKLIST_B64=)
# VIRACLIP_TAGS=cortes clipes viral
# VIRACLIP_CTA_TIKTOK=
# VIRACLIP_HANDLE=@viraclipe.oficial
# VIRACLIP_PACK_JSON={"cta":{...},"tags_base":[...],"handle":"@viraclipe.oficial"}

# Paths
DB_PATH=data/viraclipe.db
FACTORY_DATA=data/factory
QUEUE_FILE_PATH=data/queue.json
